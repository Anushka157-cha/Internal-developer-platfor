# .gitignore additions for production

# Environment files
.env*
!.env.example
!backend/.env.example
node_modules/
coverage/


# SSL Certificates
*.pem
*.key
*.crt

# Production builds
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.sqlite
*.db
dump.rdb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
